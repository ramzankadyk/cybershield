<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShield Cup | Защита Проекта</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!--  ШАПКА И АДАПТИВНОЕ МЕНЮ -->
    <header>
        <a href="#" class="logo">CyberShield</a>
        
        <nav class="nav-links" id="navLinks">
            <a href="#hero">Главная</a>
            <a href="#players">Игроки</a>
            <a href="#shop">Магазин</a>
            <a href="#calc">Калькулятор</a>
            <a href="#register">Регистрация</a>
        </nav>

        <div class="burger" id="burgerBtn">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </header>

    <!--  БАННЕР САЙТА  -->
    <section class="hero" id="hero">
        <h1>AGANYM Cup 2026</h1>
        <p>Главный киберспортивный турнир сезона. Докажи, что твоя команда лучшая!</p>
        <a href="#register" class="btn-main">Участвовать</a>
    </section>

    <!--  ГАЛЕРЕЯ ИГРОКОВ  -->
    <section class="section" id="players">
        <h2 class="title">Звезды Турнира</h2>
        
        <div class="gallery">
            <div class="card">
                <img src="collapse.jpg" alt="Collapse">
                <h3>Collapse</h3>
                <p>Игра: Dota 2<br>Роль: Offlane (Team Spirit)</p>
            </div>

            <div class="card">
                <img src="nightfall.jpg" alt="Nightfall">
                <h3>Nightfall</h3>
                <p>Игра: Dota 2<br>Роль: Carry</p>
            </div>

            <div class="card">
                <img src="ame.jpg" alt="Ame">
                <h3>Ame</h3>
                <p>Игра: Dota 2<br>Роль: Carry (Xtreme Gaming)</p>
            </div>
        </div>
    </section>

    <!--  МАГАЗИН И КОРЗИНА  -->
    <section class="section" id="shop">
        <h2 class="title">Магазин Мерча</h2>
        
        <div class="shop-grid">
            <div class="product">
                <h3>Джерси Команды</h3>
                <p class="price">2500 KZT</p>
                <button class="btn-main add-btn" data-name="Джерси Команды" data-price="2500">Купить</button>
            </div>

            <div class="product">
                <h3>Игровая Мышь</h3>
                <p class="price">5000 KZT</p>
                <button class="btn-main add-btn" data-name="Игровая Мышь" data-price="5000">Купить</button>
            </div>

            <div class="product">
                <h3>Коврик для мыши</h3>
                <p class="price">1500 KZT</p>
                <button class="btn-main add-btn" data-name="Коврик для мыши" data-price="1500">Купить</button>
            </div>
        </div>

        <!-- Корзина -->
        <div class="cart-box">
            <h3>Корзина</h3>
            <ul id="cartList">
                <li>Корзина пуста...</li>
            </ul>
            <p>Итого: <span id="totalPrice">0</span> KZT</p>
        </div>
    </section>

    <!--  МИНИ КАЛЬКУЛЯТОР БОНУСОВ -->
    <section class="section" id="calc">
        <h2 class="title">Калькулятор Призовых</h2>
        
        <div class="calc-box">
            <label>Количество побед:</label>
            <input type="number" id="winsInput" placeholder="Введите число">
            <button class="btn-main" id="calcBtn">Посчитать</button>
            <p id="calcResult">Призовые: 0 KZT</p>
        </div>
    </section>

    <!--  ФОРМА РЕГИСТРАЦИИ -->
    <section class="section" id="register">
        <h2 class="title">Регистрация На Турнир</h2>
        
        <form id="regForm" class="form">
            <input type="text" id="username" placeholder="Ваш никнейм" required>
            <input type="email" id="email" placeholder="Ваш Email" required>
            <button type="submit" class="btn-main">Зарегистрироваться</button>
        </form>
    </section>

    <!--  ПОДВАЛ -->
    <footer>
        <p>&copy; 2026 CyberShield Cup. Проект для защиты.</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
// ==========================================
//  АДАПТИВНОЕ МЕНЮ (БУРГЕР)
// ==========================================
const burgerBtn = document.getElementById('burgerBtn');
const navLinks = document.getElementById('navLinks');

burgerBtn.addEventListener('click', () => {
    // Переключаем класс 'active', который открывает/скрывает меню в CSS
    navLinks.classList.toggle('active');
});

// ==========================================
//  РАБОТА С КОРЗИНОЙ И DOM (МАГАЗИН)
// ==========================================
const addBtns = document.querySelectorAll('.add-btn');
const cartList = document.getElementById('cartList');
const totalPrice = document.getElementById('totalPrice');

let sum = 0;
let isFirstItem = true;

addBtns.forEach(btn => {
    btn.addEventListener('click', () => {
        // Убираем текст «Корзина пуста» при покупке первого товара
        if (isFirstItem) {
            cartList.innerHTML = '';
            isFirstItem = false;
        }

        // Читаем данные из атрибутов data-* у кнопки
        const name = btn.getAttribute('data-name');
        const price = Number(btn.getAttribute('data-price'));

        // Создаем новый HTML-тег <li> через DOM
        const li = document.createElement('li');
        li.textContent = `${name} — ${price} KZT`;
        cartList.appendChild(li);

        // Считаем общую сумму
        sum += price;
        totalPrice.textContent = sum;
    });
});

// ==========================================
//  МИНИ КАЛЬКУЛЯТОР ПРИЗОВЫХ
// ==========================================
const winsInput = document.getElementById('winsInput');
const calcBtn = document.getElementById('calcBtn');
const calcResult = document.getElementById('calcResult');

calcBtn.addEventListener('click', () => {
    const wins = Number(winsInput.value);
    
    // Простая формула: 1 победа = 10 000 KZT призовых
    const prize = wins * 10000;
    
    calcResult.textContent = `Призовые: ${prize} KZT`;
});

// ==========================================
//  ФОРМА РЕГИСТРАЦИи
// ==========================================
const regForm = document.getElementById('regForm');

regForm.addEventListener('submit', (event) => {
    event.preventDefault(); // Отменяем стандартную перезагрузку страницы браузером

    const name = document.getElementById('username').value;
    alert(`Поздравляем, ${name}! Вы успешно зарегистрированы на турнир!`);

    regForm.reset(); // Сбрасываем поля формы
});
/* 1. ПОДКЛЮЧЕНИЕ ШРИФТОВ И ОБЩИЕ СТИЛИ */
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    /* Меняем стандартный шрифт на футуристичный Rajdhani */
    font-family: 'Rajdhani', sans-serif;
}

body {
    background-color: #0b0c10; /* Глубокий темно-серый, почти черный */
    color: #c5c6c7;
    line-height: 1.6;
    overflow-x: hidden;
}

/* Применяем брутальный игровой шрифт Orbitron для всех заголовков и лого */
h1, h2, h3, .logo {
    font-family: 'Orbitron', sans-serif;
    letter-spacing: 1px;
}

/* 2. ШАПКА И АДАПТИВНОЕ МЕНЮ */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 5%;
    background-color: rgba(11, 12, 16, 0.95);
    backdrop-filter: blur(10px); /* Эффект матового стекла */
    border-bottom: 2px solid #1f2833;
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 24px;
    font-weight: 900;
    color: #66fcf1;
    text-decoration: none;
    text-shadow: 0 0 10px rgba(102, 252, 241, 0.4);
}

.nav-links a {
    color: #c5c6c7;
    text-decoration: none;
    margin-left: 25px;
    font-size: 16px;
    font-weight: 600;
    transition: 0.3s;
    text-transform: uppercase;
}

/* Стильный подсвет при наведении */
.nav-links a:hover {
    color: #66fcf1;
    text-shadow: 0 0 8px rgba(102, 252, 241, 0.6);
}

.burger {
    display: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
}

.burger span {
    width: 25px;
    height: 3px;
    background-color: #66fcf1;
    border-radius: 2px;
}

/* 3. БАННЕР (HERO) */
.hero {
    height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    /* Градиентное темное затемнение поверх киберспортивного фона */
    background: linear-gradient(135deg, rgba(11, 12, 16, 0.9), rgba(31, 40, 51, 0.8)), 
                url('int.jpg') center/cover no-repeat;
    margin-top: 60px;
    border-bottom: 3px solid #66fcf1;
}

.hero h1 {
    font-size: 46px;
    margin-bottom: 15px;
    color: #ffffff;
    text-shadow: 0 0 20px rgba(102, 252, 241, 0.5);
}

.hero p {
    font-size: 18px;
    color: #83c5be;
    max-width: 600px;
    padding: 0 20px;
}

/* 4. КНОПКИ С КИБЕРПАНК-ДИЗАЙНОМ */
.btn-main {
    padding: 12px 30px;
    background: linear-gradient(135deg, #45a29e, #66fcf1);
    color: #0b0c10;
    border: none;
    border-radius: 4px;
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
    margin-top: 20px;
    box-shadow: 0 0 15px rgba(102, 252, 241, 0.3);
}

.btn-main:hover {
    background: #66fcf1;
    transform: translateY(-3px);
    box-shadow: 0 0 25px rgba(102, 252, 241, 0.6);
}

/* 5. СЕКЦИИ И ГАЛЕРЕЯ КАРТОЧЕК */
.section {
    padding: 80px 5%;
    text-align: center;
}

.title {
    font-size: 32px;
    margin-bottom: 40px;
    color: #ffffff;
    position: relative;
    display: inline-block;
}

/* Неоновая линия-акцент под заголовками секций */
.title::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background-color: #66fcf1;
    margin: 8px auto 0;
    box-shadow: 0 0 10px #66fcf1;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
}

.card {
    background-color: #1f2833;
    padding: 20px;
    border-radius: 8px;
    border: 1px solid #45a29e;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: left;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
}

.card:hover {
    transform: translateY(-8px);
    border-color: #66fcf1;
    box-shadow: 0 8px 25px rgba(102, 252, 241, 0.2);
}

.card img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 15px;
    filter: brightness(0.9);
    transition: filter 0.3s;
}

.card:hover img {
    filter: brightness(1.05);
}

.card h3 {
    font-size: 22px;
    color: #66fcf1;
    margin-bottom: 5px;
}

.card p {
    font-size: 16px;
    color: #c5c6c7;
}

/* 6. МАГАЗИН, КОРЗИНА, КАЛЬКУЛЯТОР И ФОРМА */
.shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.product {
    background-color: #1f2833;
    padding: 20px;
    border-radius: 8px;
    border: 1px solid #45a29e;
    text-align: left;
    transition: 0.3s;
}

.product:hover {
    border-color: #66fcf1;
}

.cart-box, .calc-box, .form {
    background-color: #1f2833;
    padding: 30px;
    max-width: 450px;
    margin: 30px auto 0;
    border-radius: 8px;
    border: 1px solid #45a29e;
    box-shadow: 0 5px 20px rgba(0,0,0,0.4);
    text-align: left;
}

.cart-box h3, .calc-box h3 {
    color: #66fcf1;
    margin-bottom: 15px;
}

.calc-box input, .form input {
    width: 100%;
    padding: 12px;
    margin: 10px 0 20px 0;
    background-color: #0b0c10;
    border: 1px solid #45a29e;
    color: #fff;
    border-radius: 4px;
    font-size: 16px;
}

.calc-box input:focus, .form input:focus {
    border-color: #66fcf1;
    outline: none;
    box-shadow: 0 0 8px rgba(102, 252, 241, 0.4);
}

#cartList {
    list-style: none;
    margin: 15px 0;
}

#cartList li {
    padding: 8px 0;
    border-bottom: 1px solid #282c37;
    color: #c5c6c7;
}

footer {
    text-align: center;
    padding: 30px;
    background-color: #0b0c10;
    border-top: 2px solid #1f2833;
    color: #83c5be;
    font-size: 14px;
}

/* 7. АДАПТИВНЫЙ САЙТ (МОБИЛЬНАЯ ВЕРСТКА) */
@media (max-width: 768px) {
    .nav-links {
        display: none;
        flex-direction: column;
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background-color: #0b0c10;
        padding: 20px;
        border-bottom: 2px solid #66fcf1;
        text-align: center;
    }

    .nav-links a {
        margin: 15px 0;
    }

    .nav-links.active {
        display: flex;
    }

    .burger {
        display: flex;
    }

    .hero h1 {
        font-size: 32px;
    }
}
